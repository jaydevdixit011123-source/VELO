{
  "name": "velo-desktop",
  "version": "1.0.0",
  "description": "VELO - Personal AI Desktop Assistant (free, Gemini powered)",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "npx electron .",
    "dev": "npx electron . --dev",
    "build": "npx tsc",
    "dist": "npx electron-builder"
  },
  "author": "Jaydev",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0"
  },
  "devDependencies": {
    "electron": "^31.0.2",
    "typescript": "^5.4.5"
  },
  "build": {
    "appId": "com.jaydev.velo",
    "productName": "VELO",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "package.json"],
    "win": { "target": ["portable"] }
  }
}
